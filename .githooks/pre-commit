#!/bin/sh
set -eu
if [ "${ATLAS_REFRESH_INDEXES_ON_COMMIT:-0}" != "1" ]; then
    printf '%s\n' 'Index refresh skipped; before publishing run: python3 scripts/prepare-indexes.py'
    exit 0
fi
atlas_index_python=${ATLAS_INDEX_PYTHON:-}
if [ -z "$atlas_index_python" ]; then
    atlas_index_python=$(git config --get atlas.indexPython || :)
fi
exec "${atlas_index_python:-python3}" scripts/prepare-indexes.py
