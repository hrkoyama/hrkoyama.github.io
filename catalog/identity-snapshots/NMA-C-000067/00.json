{
  "id": "h2-rhf",
  "name": {
    "ja": "H₂分子RHF：独立参照・SCF・s型基底拡大",
    "en": "H₂ molecular RHF: independent reference, SCF and s-basis refinement"
  },
  "problem_id": "h2-rhf",
  "method_ids": [
    "hartree-fock",
    "electronic-bases",
    "scf"
  ],
  "scope": {
    "ja": "孤立・Born–Oppenheimer・非相対論・2電子閉殻H₂。3核間距離でSTO-3Gと入れ子s型Gaussian基底を比較。RHFの数値検証であり、分子DFT・周期系・完全基底極限や正しい解離を検証しない。",
    "en": "Isolated Born–Oppenheimer nonrelativistic two-electron closed-shell H₂. Compare STO-3G and nested s-Gaussian spaces at three separations. Numerical RHF validation, not molecular DFT, periodic, complete-basis or correct-dissociation validation."
  },
  "assumptions": {
    "ja": "固定核・一重項の制限HF、1空間軌道の二重占有。自作Gaussian積分と別実装PySCFで同じ幾何・基底を使用。",
    "en": "Fixed nuclei, singlet restricted HF, one doubly occupied spatial orbital. Original Gaussian integrals and independent PySCF use identical geometries and bases."
  },
  "units": {
    "ja": "原子単位系：核間距離bohr、全エネルギーhartree。重なり行列・電子数・密度行列の規格化は入力と解説に記載。",
    "en": "Atomic units: distances in bohr and total energies in hartree. Overlap, electron count and density normalization are specified in inputs/reading."
  },
  "boundaries": {
    "ja": "孤立有限分子、Gaussian関数による全空間積分。周期境界や有限箱を使用しない。",
    "en": "Isolated finite molecule with whole-space Gaussian integrals; no periodic boundary or finite box."
  },
