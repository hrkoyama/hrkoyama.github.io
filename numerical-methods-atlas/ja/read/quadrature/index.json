  "scoped_supplements": [
    {
      "id": "gauss-adaptive-quadrature",
      "title": {
        "ja": "Gauss–Legendreと適応求積：厳密次数・推定誤差・予算切れ",
        "en": "Gauss–Legendre and adaptive quadrature: exactness, error estimates and budgets"
      },
      "group": "foundations",
      "problem_id": "quadrature-moments",
      "summary": {
        "ja": "Legendreの3項漸化式からGauss節点と重みを構成し、2n−1次までの多項式モーメントと指数関数を検査します。適応Simpsonは指数関数とLorentz型ピークを積分し、解析積分・独立QUADPACKと比較します。",
        "en": "Construct Gaussian nodes/weights from the Legendre recurrence and test polynomial moments through degree 2n−1 and an exponential. Adaptive Simpson integrates exponential and Lorentzian peaks, against analytic integrals and independent QUADPACK."
      },
      "limits": {
        "ja": "Simpsonの局所推定は任意の関数に対する厳密な誤差上界ではありません。高周波の見落とし、特異点、丸め誤差の停滞を一般に解決する実装ではなく、Gauss–KronrodやQUADPACK全体の再実装でもありません。",
        "en": "The local Simpson estimate is not a rigorous error bound for arbitrary functions. The implementation does not generally solve missed high frequencies, singularities or roundoff stagnation, and it is not a reimplementation of Gauss–Kronrod or all of QUADPACK."
      },
      "reading": {
        "ja": "/numerical-methods-atlas/ja/read/validation-foundations/#gauss-adaptive-quadrature",
        "en": "/numerical-methods-atlas/en/read/validation-foundations/#gauss-adaptive-quadrature"
      },
