  "scoped_supplements": [
    {
      "id": "qr-svd-factorization",
      "title": {
        "ja": "Householder QRと片側Jacobi SVD：直交性・階数・最小二乗",
        "en": "Householder QR and one-sided Jacobi SVD: orthogonality, rank and least squares"
      },
      "group": "foundations",
      "problem_id": "matrix-factorization",
      "summary": {
        "ja": "実の縦長行列に対するHouseholder QRと片側Jacobi SVDを自作し、通常行列・列スケール差10⁶の行列・階数落ち行列を検査します。独立LAPACKの特異値と最小ノルム最小二乗解を照合します。",
        "en": "Original Householder QR and one-sided Jacobi SVD for real tall matrices are checked on ordinary, 10⁶-column-scaled and rank-deficient inputs, against separate LAPACK singular values and minimum-norm least-squares solutions."
      },
      "limits": {
        "ja": "完全なLAPACK置換、複素行列、横長行列、任意の極端なスケール、最適な相対特異値精度を保証しません。10⁻¹²未満の特異値は入力した数値階数の規約で打ち切るため、数学的な厳密階数と区別します。Demmel–Veselićの精度定理の全条件を実証したとは主張しません。",
        "en": "Not a full LAPACK replacement or validation of complex/wide matrices, arbitrary extreme scales or optimal relative singular-value accuracy. The 10⁻¹² cutoff defines numerical rather than exact mathematical rank. The experiment does not establish all hypotheses of the Demmel–Veselić accuracy results."
      },
      "reading": {
        "ja": "/numerical-methods-atlas/ja/read/validation-foundations/#qr-svd-factorization",
        "en": "/numerical-methods-atlas/en/read/validation-foundations/#qr-svd-factorization"
      },
