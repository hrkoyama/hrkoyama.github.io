  "scope": {
    "ja": "孤立・軟化重力の静的な力の比較。軌道計算・周期系・実行速度の比較ではありません。",
    "en": "Static isolated softened-gravity force comparison, not orbital integration, periodic gravity or a timing benchmark."
  },
  "assumptions": {
    "ja": "正の質量を持つ固定192粒子。Plummer軟化、traceを含む完全な二次モーメント項を使い、同じ核の直接和を参照。",
    "en": "192 fixed particles with positive masses; Plummer softening and the complete second-moment term including its trace, compared with direct summation using the identical kernel."
  },
  "units": {
    "ja": "無次元、G=1、軟化長0.03。入力の長さ・質量の規約を保持。",
    "en": "Dimensionless, G=1, softening 0.03; preserve input length and mass conventions."
  },
  "boundaries": {
    "ja": "3次元孤立境界。周期境界ではない。",
    "en": "3D isolated boundaries, not periodic."
  },
