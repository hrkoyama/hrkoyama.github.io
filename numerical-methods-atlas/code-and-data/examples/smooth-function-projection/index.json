        "en": "Interpolation error falls by at least a factor ten for each two-degree increase."
      },
      "pointer": "/metrics/minimum_interpolation_error_reduction"
    },
    {
      "id": "independent-modal-coefficients",
      "comparison": "maximum",
      "tolerance": 1e-11,
