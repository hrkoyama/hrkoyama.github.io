    {
      "id": "interpolation-l2-error",
      "comparison": "maximum",
      "tolerance": 5e-08,
      "description": {
        "ja": "同じ8次GLL節点補間を別の高次求積で評価する。",
        "en": "Degree-eight GLL interpolation evaluated using separate higher-order quadrature."
      },
      "pointer": "/metrics/finest_gll_interpolation_l2_error"
    },
    {
      "id": "projection-degree-refinement",
      "comparison": "minimum",
      "tolerance": 10,
