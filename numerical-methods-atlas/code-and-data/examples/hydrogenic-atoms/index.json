  "id": "hydrogenic-atoms",
  "name": {
    "ja": "水素型原子：解析解と格子収束",
    "en": "Hydrogenic atoms: analytic references and grid refinement"
  },
  "problem_id": "hydrogenic-atoms",
  "method_ids": [
    "schrodinger"
  ],
  "scope": {
    "ja": "孤立した1電子のH・He⁺について、1s・2s・2p・3dのエネルギーと動径軌道を解析解と比較します。多電子原子や分子の直接解法ではありません。",
    "en": "Isolated one-electron H and He⁺: compare 1s, 2s, 2p and 3d energies and radial orbitals against analytic solutions. Not a direct many-electron or molecular solver."
  },
  "assumptions": {
    "ja": "非相対論・無限質量の点核。核電荷Z=1,2。縮約動径軌道を一様格子の2次中心差分で離散化。",
    "en": "Nonrelativistic infinite-mass point nucleus, Z=1,2. Reduced radial orbitals use second-order central differences on a uniform mesh."
  },
  "units": {
    "ja": "原子単位系：エネルギーhartree、距離bohr。",
    "en": "Atomic units: energy in hartree, distance in bohr."
  },
  "boundaries": {
    "ja": "孤立系、u(0)=u(r_max)=0。主計算r_max=60 bohr。H 1sの領域打切り依存は別に検査。",
    "en": "Isolated boundaries, u(0)=u(r_max)=0. Main domain r_max=60 bohr; hydrogen 1s has a separate box-truncation study."
  },
