  "checks": [
    {
      "id": "normalization",
      "pointer": "/hydrogenic/refinement",
      "comparison": "abs_difference",
      "description": {
        "ja": "動径軌道の規格化",
        "en": "Reduced-orbital normalization"
      },
      "field": "norm",
      "expected": 1,
      "tolerance": 1e-12
    },
    {
      "id": "eigen-residual",
      "pointer": "/hydrogenic/refinement",
      "comparison": "maximum",
      "description": {
        "ja": "全固有値問題の残差",
        "en": "All eigenpair residuals"
      },
      "field": "eigen_residual",
      "tolerance": 1e-07,
      "units": "hartree"
    },
    {
      "id": "analytic-energy-fine-grid",
      "pointer": "/hydrogenic/refinement",
      "comparison": "maximum",
      "description": {
        "ja": "最細格子の解析解との差",
        "en": "Finest-grid analytic energy errors"
      },
      "field": "energy_error",
      "where": {
        "dr": 0.01
      },
      "tolerance": 0.00021,
      "units": "hartree"
    },
    {
      "id": "energy-refinement",
      "pointer": "/checks/hydrogenic_exact_energy_errors_reduce",
      "comparison": "equals",
      "description": {
        "ja": "格子細分による誤差低減",
        "en": "Energy-error reduction under refinement"
      },
      "expected": true
    }
  ],
