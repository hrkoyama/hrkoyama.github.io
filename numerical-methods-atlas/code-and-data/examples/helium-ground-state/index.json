  "scope": {
    "ja": "Heの球対称1s²・閉殻HFとスピン非偏極Dirac交換のみLDAを比較します。電子相関・分子・周期系は含みません。",
    "en": "Compare spherical 1s² closed-shell helium HF and spin-unpolarized Dirac exchange-only LDA. No electron correlation, molecules or periodic systems."
  },
  "assumptions": {
    "ja": "非相対論・無限質量の点核、2電子が単一1s空間軌道を二重占有。2次中心差分と線形密度混合。HF交換の局所還元はこの2電子問題に限定。",
    "en": "Nonrelativistic infinite-mass point nucleus, two electrons doubly occupying a single 1s spatial orbital. Second-order central differences and linear density mixing. Local HF exchange reduction is specific to this two-electron problem."
  },
  "units": {
    "ja": "原子単位系：エネルギーhartree、距離bohr。",
    "en": "Atomic units: energy in hartree, distance in bohr."
  },
  "boundaries": {
    "ja": "球対称の孤立系、u(0)=u(r_max)=0。主計算r_max=16 bohr。格子幅と領域打切りを別々に検査。",
    "en": "Spherical isolated system, u(0)=u(r_max)=0. Main domain r_max=16 bohr; mesh and box truncation are studied separately."
  },
