{
  "id": "rk45",
  "name": {
    "ja": "Dormand–Prince RK45",
    "en": "Dormand–Prince RK45"
  },
  "group": {
    "id": "time",
    "ja": "時間積分",
    "en": "Time integration"
  },
  "summary": {
    "ja": "埋込み5(4)誤差推定と刻み制御、4次の連続拡張、向き付きイベントを組み合わせる陽的時間積分です。",
    "en": "Explicit time integration combines an embedded 5(4) error estimator, adaptive steps, a quartic continuous extension and directed events."
  },
  "status": "educational-example",
  "origin": "development-candidate",
  "reading": {
    "ja": "https://hrkoyama.github.io/numerical-methods-atlas/ja/read/runge-kutta/",
    "en": "https://hrkoyama.github.io/numerical-methods-atlas/en/read/runge-kutta/"
  },
  "code_modules": [],
  "test_files": [],
  "code_mapping_scope": "Scoped fixed-input examples; original method variants and earlier releases remain distinct.",
  "code_mapping_scope_ja": "実行の根拠は版を固定した追加配布例です。章へのリンクは補足解説です。",
  "assumptions": [
    "The target is a smooth nonstiff initial-value problem; tolerances must match component scales.",
    "FSAL reuses the RHS owned by the accepted state and never promotes a rejected trial endpoint.",
    "Simple sign crossings are localized on interpolants of retained accepted steps."
  ],
  "assumptions_ja": [
    "滑らかな非硬い初期値問題を対象とし、許容誤差は成分の尺度に合わせます。",
    "FSALは受理状態の右辺を再利用し、棄却した試行の端点で置き換えません。",
    "保存した受理区間の補間を用いて単純な符号交差を探します。"
  ],
  "units": "Time and step size share units; atol has each state component's units and rtol is dimensionless.",
  "units_ja": "時刻と刻みは同じ単位です。atolは各成分、rtolは無次元の尺度です。",
  "boundary_conditions": "The ODE step has no spatial boundary; an RHS for a semidiscrete PDE must supply its boundaries.",
  "boundary_conditions_ja": "ODE自体に空間境界はなく、空間離散した系では右辺が境界を供給します。",
  "limitations": {
    "ja": "硬い系、接触根、1刻み内の複数交差、reset系の一般保証はありません。局所許容誤差を大域誤差の上界とみなしません。",
    "en": "No general guarantee is provided for stiff systems, tangential roots, multiple crossings per step or reset systems. Local tolerances are not global error bounds."
  },
  "aliases": [
    "RK45",
    "Dormand-Prince 5(4)",
    "DOPRI5",
    "埋込みRunge–Kutta"
  ],
