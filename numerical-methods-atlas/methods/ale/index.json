        "id": "ale-nonuniform-transport",
        "title": {
          "ja": "非一様移動格子で実際に運ぶALEスカラー",
          "en": "ALE scalar transport on genuinely nonuniform moving cells"
        },
        "method_ids": [
          "ale",
          "upwind",
          "heun"
        ],
        "domains": [
          "pde",
          "geometry"
        ],
        "summary": {
          "ja": "質量と格子面位置を同じHeun段で更新し、一様GCLだけでなく非一様な解析波を運びます。",
          "en": "Advance cell integrals and face positions with identical Heun stages, transporting a nonuniform analytic wave beyond a uniform GCL check."
        },
        "assumptions": {
          "ja": "周期[0,1]、速度.7、q0=1+.2sin(2pi x)、面速度w=.2sin(2pi xi)cos(2pi t)、N40/80/160、T1。時間比較N40,T.25,32/64/128step。",
          "en": "Periodic unit interval, speed.7,q0=1+.2sin(2pi x), grid speed .2sin(2pi xi)cos(2pi t),N40/80/160,T1. Separate N40,T.25 time series32/64/128steps."
        },
        "algorithm": {
          "ja": "実セル質量の上流相対流束(a−w)qと実面位置を同じHeun predictor/correctorで進め、各段体積・面Courant数を記録。",
          "en": "Upwind relative flux(a-w)q advances actual masses with identical predictor/corrector face geometry; record stage volumes and Courant numbers."
        },
        "validation": {
          "ja": "解析的移動セル積分、全体/段の質量、GCLconstant、格子幾何誤差を分離。独立DOP853による同じFV ODEの時間参照を二公差で確認。",
          "en": "Separate analytic moving-cell-integral error, global/stage mass, constant GCL and geometry error. Qualify an independent DOP853 integration of the same FV ODE with two tolerances."
        },
        "limits": {
          "ja": "1D指定格子運動の第一段階です。図のx–tは2D物理計算ではなく、Euler Lagrange/remapやSaltzmanピストンは未実装の後続課題。",
          "en": "First-stage1D prescribed mesh motion. The x–t image is not2D physics; Euler Lagrange/remap and Saltzman piston remain future work."
        },
        "references": [
          {
            "id": "huff1987-moving-grid",
            "author": "Dennis L. Huff",
            "year": 1987,
            "title": "Numerical Simulations of Unsteady, Viscous, Transonic Flow Over Isolated and Cascaded Airfoils Using a Deforming Grid",
            "url": "https://ntrs.nasa.gov/api/citations/19870015002/downloads/19870015002.pdf",
            "review_level": "selected-primary-report-grid-treatment",
            "review_scope": "NASA TM89890 grid-velocity and GCL discussion around equation11/printedp5 inspected. It attributes GCL to Thomas/Lombard. Original1979 paper not read; no airfoil algorithm or code reproduced. Our 1D scalar moving-volume/Heun derivation is independent."
          }
        ],
        "citations": [
          {
            "id": "huff1987-moving-grid",
            "author": "Dennis L. Huff",
            "year": 1987,
            "title": "Numerical Simulations of Unsteady, Viscous, Transonic Flow Over Isolated and Cascaded Airfoils Using a Deforming Grid",
            "url": "https://ntrs.nasa.gov/api/citations/19870015002/downloads/19870015002.pdf",
            "review_level": "selected-primary-report-grid-treatment",
            "review_scope": "NASA TM89890 grid-velocity and GCL discussion around equation11/printedp5 inspected. It attributes GCL to Thomas/Lombard. Original1979 paper not read; no airfoil algorithm or code reproduced. Our 1D scalar moving-volume/Heun derivation is independent."
          }
        ],
        "formulas": [
          "\\dot m_i=-[(a-w)q]_{i+1/2}+[(a-w)q]_{i-1/2},\\quad V_i=x_{i+1/2}-x_{i-1/2}",
