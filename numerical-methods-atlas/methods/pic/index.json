    "examples": [
      {
        "id": "pic",
        "title": {
          "ja": "CIC静電PICの冷たいプラズマ振動",
          "en": "Cold-plasma oscillation with electrostatic CIC PIC"
        },
        "method_ids": [
          "pic"
        ],
        "summary": {
          "ja": "1次元周期セルの電子をCICで格子と結び、Poisson方程式と粒子運動を自洽に進めます。",
          "en": "Couple electrons to a 1D periodic grid by CIC, solving Poisson and particle motion self-consistently."
        },
        "assumptions": {
          "ja": "長さ2pi、電子の電荷質量比−1、静止イオン背景密度1、plasma frequency=1の無次元系。quiet startから振幅0.001の微小正弦変位を与えます。",
          "en": "Dimensionless length 2pi, electron charge/mass −1, stationary ion density one and plasma frequency one. A quiet start receives a small sinusoidal displacement of amplitude 0.001."
        },
        "algorithm": {
          "ja": "CIC電荷割当てと同じ重みの場補間、ゼロ平均のスペクトルPoisson解、速度Verletを組み合わせます。実数の奇微分の規約により、電場のNyquistモードはゼロにします。",
          "en": "Combine CIC deposition and matching field gathering, a mean-zero spectral Poisson solve and velocity Verlet. Set the field Nyquist mode to zero for a real skew-adjoint spectral derivative."
        },
        "validation": {
          "ja": "32・64・128格子の系列と、別の512格子上の時間刻み系列を分けます。変位モードを連続線形理論のcos(t)と比較し、全電荷・Poissonポテンシャル残差・単一粒子の自己力を検査します。",
          "en": "Separate a 32/64/128-grid sweep from timestep refinement on a 512 grid. Compare displacement amplitude with continuum linear cos(t), and check charge compatibility, potential-Poisson residual and single-particle self force."
        },
        "limits": {
          "ja": "有限振幅・有限粒子数の誤差床があります。非線形不安定性、Landau減衰、衝突、電磁PIC、相対論粒子、境界流入出の検証ではありません。",
          "en": "Finite amplitude and finite particles leave an error floor. Nonlinear instabilities, Landau damping, collisions, electromagnetic/relativistic PIC and open particle boundaries are unvalidated."
        },
        "equations": [
          "\\dot x_i=v_i,\\quad\\dot v_i=-E_h(x_i),\\quad-\\phi_{xx}=\\rho,\\quad E=-\\phi_x",
          "A(t)/A(0)\\simeq\\cos(\\omega_pt),\\qquad\\omega_p=1"
        ],
        "references": [
          {
            "id": "hockney-eastwood1988",
            "author": "R. W. Hockney and J. W. Eastwood",
            "year": 1988,
            "title": "Computer Simulation Using Particles",
            "doi": "10.1201/9780367806934",
            "url": "https://doi.org/10.1201/9780367806934",
