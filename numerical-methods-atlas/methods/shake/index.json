{
  "id": "shake",
  "name": {
    "ja": "SHAKE拘束積分",
    "en": "SHAKE constrained integration"
  },
  "group": {
    "id": "time",
    "ja": "時間積分",
    "en": "Time integration"
  },
  "summary": {
    "ja": "位置拘束を解くVerlet型の離散写像です。振り子では連続な近傍枝を固定し、中心差分で再構成した運動量を区別します。",
    "en": "A Verlet-type discrete map solves position constraints. The pendulum example selects the nearby continuous branch and distinguishes momentum reconstructed by centered differences."
  },
  "status": "educational-example",
  "origin": "development-candidate",
  "reading": {
    "ja": "https://hrkoyama.github.io/numerical-methods-atlas/ja/read/symplectic/",
    "en": "https://hrkoyama.github.io/numerical-methods-atlas/en/read/symplectic/"
  },
  "code_modules": [],
  "test_files": [],
  "code_mapping_scope": "Scoped fixed-input examples; original method variants and earlier releases remain distinct.",
  "code_mapping_scope_ja": "実行の根拠は版を固定した追加配布例です。章へのリンクは補足解説です。",
  "assumptions": [
    "The planar pendulum has unit mass, length and gravity, initial angle 0.7 and zero initial angular velocity.",
    "The position-constraint solve uses fixed iteration and residual limits; nonconvergence is retained as failure."
  ],
  "assumptions_ja": [
    "単位質量・長さ・重力の平面振り子で、初期角は0.7、初期角速度は0です。",
    "位置拘束の非線形解法は反復上限と残差基準を固定し、未収束を成功に置き換えません。"
  ],
  "units": "The fixed example is nondimensional; constraint and multiplier units depend on the formulation in general.",
  "units_ja": "固定例は無次元です。一般には拘束と乗数の単位は定式化に依存します。",
  "boundary_conditions": "There is no spatial boundary; conditions are the position and velocity constraint manifolds.",
  "boundary_conditions_ja": "空間境界はなく、位置と速度の拘束面が条件です。",
  "limitations": {
    "ja": "中心差分運動量の接線残差をRATTLEの速度拘束と同一視しません。単一の滑らかな円拘束の固定例であり、一般の拘束ネットワークは未検証です。",
    "en": "The tangency residual of reconstructed centered momentum is distinct from the RATTLE velocity constraint. Only fixed examples with one smooth circular constraint are validated; general constraint networks are outside this release."
  },
  "aliases": [
    "SHAKE",
    "SHAKE algorithm"
  ],
