        "id": "langevin-harmonic",
        "title": {
          "ja": "Langevin温度制御：正準分布・刻み偏り・時間相関",
          "en": "Langevin thermostat: canonical distributions, timestep bias and correlation"
        },
        "method_ids": [
          "langevin-thermostat"
        ],
        "domains": [
          "temperature",
          "probability",
          "time"
        ],
        "summary": {
          "ja": "調和振動子のBAOABを、正準分布と離散Lyapunov定常分布、連続・離散の時間相関へ照合します。",
          "en": "Compare harmonic BAOAB with canonical and discrete-Lyapunov stationary distributions, and with continuous/discrete time correlations."
        },
        "assumptions": {
          "ja": "質量・Boltzmann定数・角振動数・摩擦・温度は1。独立32768複製、burn時間20、刻み0.4/0.2/0.1、相関lag時間2。h*omega<2を要求します。",
          "en": "Mass, Boltzmann constant, frequency, friction and temperature are one. Use 32768 replicas, burn time 20, steps 0.4/0.2/0.1 and correlation lag 2; require h*omega<2."
        },
        "algorithm": {
          "ja": "力B・ドリフトAの半ステップと厳密OUノイズ更新OをB-A-O-A-Bで合成。サンプルの共分散・3種のCDF・エネルギー平均/分散・位置相関を記録します。",
          "en": "Compose force B and drift A half steps with exact OU noise O in B-A-O-A-B order. Record covariance, three CDFs, energy mean/variance and position correlation."
        },
        "validation": {
          "ja": "SciPy離散Lyapunov解および調和系の明示共分散diag(T/omega²,T(1-h²omega²/4))で照合。運動量の刻み2次偏りと有限標本誤差を分離し、burn過渡を写像で評価。連続相関は別の行列指数で算出します。",
          "en": "Check against a SciPy discrete-Lyapunov solve and explicit harmonic covariance diag(T/omega²,T(1-h²omega²/4)). Separate second-order momentum bias from sampling error and evaluate burn transients from the map. A separate matrix exponential gives continuous correlation."
        },
        "limits": {
          "ja": "調和ポテンシャル・固定seedの分布検証です。位置分散が正確でも運動量には有限刻み偏りがあります。他のサーモスタット、一般分子系、長時間の第一原理MDへ検証を移しません。",
          "en": "Distribution checks use a harmonic potential and fixed seeds. Exact position variance does not remove finite-step momentum bias. Evidence does not transfer to other thermostats, general molecules or long ab initio MD."
        },
        "formulas": [
          "dq=p\\,dt,\\qquad dp=-\\omega^2q\\,dt-\\gamma p\\,dt+\\sqrt{2\\gamma T}\\,dW",
          "\\Sigma=M\\Sigma M^T+Q,\\qquad \\Sigma_{h}=\\operatorname{diag}(T/\\omega^2,T(1-h^2\\omega^2/4))"
        ],
        "references": [
          {
            "id": "leimkuhler-matthews2013",
            "author": "B. Leimkuhler and C. Matthews",
            "year": 2013,
            "title": "Rational Construction of Stochastic Numerical Methods for Molecular Sampling",
            "doi": "10.1093/amrx/abs010",
            "url": "https://arxiv.org/abs/1203.5428",
            "review_level": "author-manuscript-selected-appendix",
            "review": {
              "ja": "著者稿の抄録、Langevin式、付録のBAOAB更新式（印刷22ページ）を確認。一般分子の超収束や原著の長時間計算を再現したとは主張しません。",
              "en": "Author manuscript abstract, Langevin equation and BAOAB update in the appendix (printed page 22) checked. The original long molecular runs and general-system superconvergence are not reproduced here."
            },
            "type": "article",
            "journal": "Applied Mathematics Research eXpress2013(1),34–56"
