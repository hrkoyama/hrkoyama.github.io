        "id": "symmetric-saddle-minres",
        "title": {
          "ja": "対称不定値鞍点系とSchur前処理",
          "en": "Symmetric saddle systems and Schur preconditioning"
        },
        "domains": [
          "linear-algebra"
        ],
        "method_ids": [
          "minres",
          "gmres"
        ],
        "source_files": [
          "solvers.py",
          "fixtures.py",
          "run.py",
          "references/oracles.py"
        ],
        "assumptions": {
          "ja": "速度12/24、圧力5/11の代数的混合Poisson/Stokes型ブロック。元の真の残差1e-9を共通基準にします。",
          "en": "Algebraic mixed-Poisson/Stokes-type blocks with velocity sizes 12 and 24 and pressure sizes 5 and 11. The common original-system residual tolerance is 1e-9."
        },
        "algorithm": {
          "ja": "全基底保存のLanczos最小残差LSと二重MGS GMRES。SPD合同変換で対称性を保持。 元入力の残差1e-9と固定前進上限2e-8から、行列のみのκ∞推定で内部目標min(rtol,2e-8/κ∞)を導出。独立解を停止に使わない。",
          "en": "Stored-basis Lanczos least squares provides the educational MINRES variant; GMRES uses two-pass modified Gram-Schmidt. An SPD congruence preserves symmetry. The internal target is min(configured rtol, fixed forward-error limit / kappa_infinity), using only the matrix. The independent solution is not a stopping input."
        },
        "validation": {
          "ja": "LAPACK全系解、理想Schurの3点スペクトル、CGの明示的負曲率対照。",
          "en": "Global LAPACK solutions, the analytic ideal-Schur spectrum and an explicit negative-curvature control for CG."
        },
        "limits": {
          "ja": "理想Schurは教育用の稠密制御であり、実Stokes PDEやスケーラブルな近似前処理の完成ではありません。",
          "en": "A dense, ideal-Schur educational control, not a complete Stokes PDE solver or a scalable approximate preconditioner."
        },
        "review_level": {
          "ja": "入力・16独立参照・195科学判定は旧版から不変。R4科学実行の実際の成否はresult.json/verification.jsonへ記録し、旧失敗と別に保持します。",
          "en": "The fixed inputs, 16 independent reference checks and 195 scientific gates are unchanged. R4 passed the primary validation; actual package checks are recorded in result.json and verification.json. Earlier failed attempts remain separate."
        },
        "formulas": [
          "A=[[H,B^T],[B,0]]",
          "P=diag(H,BH^-1B^T)",
          "A_tilde=L^-1 A L^-T"
        ],
