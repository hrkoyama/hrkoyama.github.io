{
  "id": "cg",
  "name": {
    "ja": "共役勾配法",
    "en": "Conjugate gradients"
  },
  "group": {
    "id": "solvers",
    "ja": "線形・非線形解法",
    "en": "Linear & nonlinear solvers"
  },
  "summary": {
    "ja": "実対称正定値な連立一次方程式を共役方向で反復的に解く。公開例は単位正方形・零Dirichlet Poisson方程式の五点差分を、行列を組み立てずに扱う前処理なしCG。",
    "en": "Solve real SPD linear systems by conjugate directions. The public example is unpreconditioned matrix-free CG for the five-point zero-Dirichlet Poisson operator on a unit square."
  },
  "status": "educational-example",
  "origin": "existing-coverage-catalog",
  "reading": {
    "ja": "https://hrkoyama.github.io/numerical-methods-atlas/ja/read/elliptic/",
    "en": "https://hrkoyama.github.io/numerical-methods-atlas/en/read/elliptic/"
  },
  "code_modules": [
    "linear",
    "multigrid",
    "poisson_comparison"
  ],
  "test_files": [
    "test_linear",
    "test_multigrid",
    "test_poisson_comparison"
  ],
  "code_mapping_scope": "Scoped fixed-input examples; original method variants and earlier releases remain distinct.",
  "references": [
    {
      "url": "https://doi.org/10.6028/jres.049.044",
      "label": "Hestenes, M. R. & Stiefel, E. (1952). Methods of Conjugate Gradients for Solving Linear Systems.",
      "scope": "Real SPD conjugate-gradient recurrence; not the heat time integrator used elsewhere in the chapter.",
      "role": "original-method",
      "kind": "primary-research",
      "supports": {
        "ja": "実対称正定値系に対するCGの反復式と、丸め誤差がある場合の有限回終了の限界。",
        "en": "CG recurrence for real SPD systems and the qualification of finite termination in floating-point arithmetic."
      },
      "verification": {
        "checked_on": "2026-11-22",
        "level": "full-text",
        "url": "https://nvlpubs.nist.gov/nistpubs/jres/049/6/v49.n06.a08.pdf",
        "locator": "Sections 2–3, especially (3:1) and the discussion of rounding error, pp. 410–411."
      },
      "bibliography_id": "hestenes1952-5a277d"
    }
  ],
  "assumptions": [
    "The operator must be real SPD and the right-hand side finite; the example discretizes constant-coefficient −Δu=f on a uniform square grid.",
    "Inner products are Euclidean array products; the current implementation starts from zero and has no preconditioner.",
    "poisson_comparison.solve stops on a recomputed true relative residual; linear.poisson_2d uses a recurrence residual with tolerance×max(1,initial residual)."
  ],
  "units": "CG has no intrinsic physical unit. The public Poisson coordinates have unit dimensionless length; dimensionally [f]=[u]/[length]². Residual norms are unweighted array norms.",
  "boundary_conditions": "CG itself supplies no physical boundary condition. The public 2D Poisson examples impose u=0 on every side of [0,1]² by zero padding.",
  "limitations": {
    "ja": "非対称・不定・特異な系にそのまま適用しない。前処理、一般疎行列入力、純Neumannの零空間処理はこのCG例にはない。小さい残差は離散化誤差の保証ではなく、単一固有モードの速い終了を一般的性能と解釈しない。",
    "en": "Do not apply this variant directly to nonsymmetric, indefinite or singular systems. This CG example has no preconditioner, general sparse-matrix interface or pure-Neumann nullspace handling. A small residual does not certify discretization accuracy; rapid termination for one eigenmode is not a general performance result."
  },
  "metadata_review": {
    "level": "method-specific sources and implementation inspected; no new numerical rerun",
    "on": "2026-11-22"
  },
  "assumptions_ja": [
    "作用素は実対称正定値で、右辺は有限。ここでは定係数の −Δu=f を一様正方格子で離散化する。",
    "内積は配列成分のEuclidean内積。既存実装の初期値は零で、前処理は用いない。",
    "poisson_comparison.solve は再計算した真の相対残差を停止に使う。linear.poisson_2d は反復残差と tolerance×max(1,初期残差) を使う。"
  ],
  "units_ja": "CG自体に固有の物理単位はない。公開Poisson例は長さ1の無次元座標で、次元を与えるなら [f]=[u]/[長さ]²。残差は格子体積で重み付けしない配列ノルム。",
  "boundary_conditions_ja": "代数解法としてのCGは境界を定めない。公開2次元Poisson例は [0,1]² の全辺で u=0 をゼロ埋め込みにより課す。",
  "method_review": {
    "version": 1,
    "on": "2026-11-22",
