{
  "id": "reaction-diffusion-fourier",
  "title": {
    "ja": "反応拡散：空間2次と時間4次を分けて測る",
    "en": "Reaction-diffusion: separate second-order space and fourth-order time"
  },
  "method_ids": [
    "centered-difference",
    "rk4"
  ],
  "domains": [
    "biology",
    "diffusion",
    "time"
  ],
  "summary": {
    "ja": "線形の拡散・反応演算子を、連続と半離散のFourier厳密解を用いて小規模に検証します。",
    "en": "Validate a small linear diffusion-reaction operator against continuous and semidiscrete Fourier solutions."
  },
  "assumptions": {
    "ja": "周期区間[0,2pi)、D=0.1、r=0.1、初期cos(2x)、終了t=2。格子16/32/64と、別の固定格子で刻み0.5/0.25/0.125を用います。",
    "en": "Periodic[0,2pi), D=0.1,r=0.1, initial cos(2x), final t=2. Use grids 16/32/64 and a separate fixed-grid timestep sequence 0.5/0.25/0.125."
  },
  "algorithm": {
    "ja": "周期中心2階差分と独自RK4で進めます。空間系列は小さな同一時間刻み、時間系列は同じ空間演算子を用います。",
    "en": "Advance original periodic second-centered differences with RK4. The spatial sequence uses one small time step; the temporal sequence fixes the spatial operator."
  },
  "validation": {
    "ja": "連続固有値r-Dk²への最大誤差で空間次数、半離散固有値r-4Dsin²(kdx/2)/dx²への最大誤差で時間次数を測ります。独立した解析参照であり同じ実装の細格子値を参照にしません。",
    "en": "Measure spatial order against r-Dk² and temporal order against r-4Dsin²(kdx/2)/dx². Both are independent analytic references, rather than a finer-grid run of the same solver."
  },
  "limits": {
    "ja": "線形・周期・滑らかな単一モードだけを検証します。非線形のFisher前線、複雑境界、空間生態系や一般の反応ネットワークの検証ではありません。",
    "en": "Only a linear, periodic, smooth single mode is verified. Nonlinear Fisher fronts, complex boundaries, spatial ecosystems and general reaction networks remain outside scope."
  },
  "formulas": [
    "u_t=D u_{xx}+r u,\\qquad u(x,t)=e^{(r-Dk^2)t}\\cos(kx)",
    "\\lambda_h=r-\\frac{4D}{\\Delta x^2}\\sin^2(k\\Delta x/2)"
  ],
