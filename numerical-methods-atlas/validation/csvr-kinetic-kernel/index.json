{
  "id": "csvr-kinetic-kernel",
  "method_ids": [
    "stochastic-velocity-rescaling"
  ],
  "domains": [
    "temperature"
  ],
  "code_files": [
    "run.py",
    "thermostats.py"
  ],
  "title": {
    "ja": "CSVRの厳密浴：条件付き分布・揺らぎ・運動エネルギー相関",
    "en": "Exact CSVR bath: conditional laws, fluctuations and kinetic correlation"
  },
  "summary": {
    "ja": "自由度1・2・6のCSVR浴だけを実装し、厳密な条件付きモーメントと非心χ²分布、正準Gamma分布と運動エネルギー相関を照合します。",
    "en": "Implement the bath-only CSVR update for 1, 2 and 6 degrees of freedom; compare exact conditional moments/noncentral-chi-square laws, canonical Gamma fluctuations and kinetic correlations."
  },
  "assumptions": {
    "ja": "kB=1、T=1.3、τ=0.5、h=0.2、65536独立複製。3初期Kと3自由度で条件付き分布を測定。Hamiltonianの力・座標・拘束・COM除去は含みません。",
    "en": "kB=1, T=1.3, tau=0.5, h=0.2, 65536 independent replicas. Test three initial energies at each of three degree counts. No Hamiltonian force, positions, constraints or center-of-mass removal."
  },
  "algorithm": {
    "ja": "平方完成した厳密CIR遷移を、標準正規Rと独立χ²(Nf−1)のSから作ります。同じRでglobal αの符号を決め、Nf=1ではS=0。単位方向と新しい半径からpを再構成し、極小KでKnew/Kを作りません。K=0は方向が未定義として拒否します。",
    "en": "Use the completed-square exact CIR transition with normal R and independent chi-square(Nf−1) S. The same R sets the sign of global alpha; S=0 for Nf=1. Reconstruct momentum from its unit direction and new radius without a tiny-K energy ratio. Reject K=0 because its direction is undefined."
  },
  "validation": {
    "ja": "条件付き平均・分散は独立なCIR式、CDFの3確率点はSciPyの非心χ²分位点、定常KはGamma分布、浴単独ACFはexp(−t/τ)と照合。無雑音の平均緩和は分散を失う対照として別表示します。",
    "en": "Compare with separate CIR conditional moments, three SciPy noncentral-chi-square quantile probabilities, stationary Gamma K and bath-only exp(−t/tau) correlation. A separate noiseless mean-relaxation control demonstrates loss of fluctuations."
  },
  "limits": {
    "ja": "浴の診断用ケースで独立した物理問題数へ加算しません。浴がKを正しく分布させてもglobal rescalingだけでは方向を熱化しません。exp(−t/τ)を力付きMDのK相関へ流用しません。固定seedと予算に対する統計判定で、一般の混合保証ではありません。",
    "en": "A bath diagnostic, not another independent physical problem. Correct K sampling does not thermalize momentum directions by global scaling alone. The bath-only exp(−t/tau) identity is not a full-MD kinetic ACF. Statistical decisions apply to fixed seeds/budgets, not general mixing guarantees."
  },
  "formulas": [
    "\\bar K=\\frac{N_fT}{2},\\quad c=e^{-h/\\tau},\\quad A=\\frac{T(1-c)}2,\\quad R\\sim N(0,1),\\ S\\sim\\chi^2_{N_f-1}",
    "K^\\prime=(\\sqrt{cK}+\\sqrt A R)^2+AS,\\quad \\operatorname{sign}\\alpha=\\operatorname{sign}(\\sqrt{cK}+\\sqrt A R)",
    "\\mathbb E[K^\\prime\\mid K]=cK+(1-c)\\bar K,\\quad\\operatorname{Var}(K^\\prime\\mid K)=2TKc(1-c)+\\frac{N_fT^2}{2}(1-c)^2",
    "K\\sim\\operatorname{Gamma}(N_f/2,T),\\quad\\operatorname{Var}(T_{\\rm inst})=\\frac{2T^2}{N_f},\\quad C_K^{\\rm bath}(t)=e^{-t/\\tau}"
  ],
  "references": [
    {
      "id": "bussi2007csvr",
      "author": "G. Bussi, D. Donadio and M. Parrinello",
      "year": 2007,
      "title": "Canonical sampling through velocity rescaling",
      "type": "article",
      "journal": "The Journal of Chemical Physics 126, 014101",
      "doi": "10.1063/1.2408420",
      "url": "https://arxiv.org/html/0803.4060v1",
      "review_level": "author-manuscript-selected-theory-and-appendix",
      "review": {
        "ja": "2007年原著の著者稿arXiv:0803.4060v1（2008年掲示）のII.1–II.3、Appendix Aの厳密運動エネルギー更新を確認。SISSAの出版社PDFは取得できず、原著の分子系を再現したものではありません。χ²は直接生成し、著者が後に指摘したΓ生成手順のtypoを写しません。",
        "en": "Checked theory II.1–II.3 and the exact kinetic-energy propagator in Appendix A of the author manuscript arXiv:0803.4060v1 (posted 2008 for the 2007 article). The SISSA publisher PDF was unavailable. Original molecular applications are not reproduced. Direct chi-square sampling avoids copying the gamma-generation typo later noted by the author."
      }
    },
    {
      "id": "bussi2008localglobal",
      "author": "G. Bussi and M. Parrinello",
      "year": 2008,
      "title": "Stochastic thermostats: comparison of local and global schemes",
      "type": "article",
      "journal": "Computer Physics Communications 179(1–3), 26–29",
      "doi": "10.1016/j.cpc.2008.01.006",
      "url": "https://arxiv.org/html/0803.4397v1",
      "review_level": "author-manuscript-selected-equations-and-algorithm",
      "review": {
        "ja": "著者稿のI・II節、式(8)の有限刻み更新、式(9)のα符号、同じGaussianの使用、Nf=1のLangevin同値、τ=1/(2γ)を確認。原著Lennard-Jonesの長時間輸送係数は再現していません。",
        "en": "Checked sections I–II, finite-step update Eq. (8), the sign of alpha in Eq. (9) using the same Gaussian, the Nf=1 Langevin limit and tau=1/(2 gamma). The original long Lennard-Jones transport calculations are not reproduced."
      }
    },
    {
      "id": "bussi-csvr-author-algorithms",
      "author": "Giovanni Bussi",
      "year": 2026,
      "title": "Research algorithms: stochastic velocity rescaling",
      "type": "misc",
      "url": "https://sites.google.com/site/giovannibussi/Research/algorithms",
      "review_level": "author-official-algorithm-note",
      "review": {
        "ja": "著者の公式アルゴリズム頁にある2007年論文のGaussian二乗和をΓ分布で生成する記述のtypo注記を確認。年は確認年。配布コードの転載ではなく独自実装です。",
        "en": "Checked the author’s official note identifying a typo in the 2007 paper’s gamma-based generation of Gaussian-square sums. Year is access year. This is an original implementation, not a reproduction of the downloadable code."
      }
    }
  ],
