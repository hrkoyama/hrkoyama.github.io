{
  "id": "qr-svd-conditioning",
  "title": {
    "ja": "QR/SVD：既定特異値・摂動増幅・数値階数",
    "en": "QR/SVD: prescribed spectra, perturbation gain and numerical rank"
  },
  "method_ids": [
    "qr-svd"
  ],
  "summary": {
    "ja": "二進で厳密に表現できる16×4行列の条件数を1から2³⁶まで変え、再構成誤差と解誤差を分けます。実際のbinary64入力に対し別環境で実行した80/120桁参照とLAPACKを比較します。",
    "en": "Vary condition number from 1 to 2³⁶ for exactly representable 16×4 dyadic matrices, separating reconstruction from forward solution error. Compare LAPACK and separately executed 80/120-digit references for the actual binary64 inputs."
  },
  "assumptions": {
    "ja": "Hadamard直交因子U,Vとsⱼ=2⁻qj、q=0/4/8/12を使います。b=u₀とb+2⁻⁴⁰u_minを固定し、摂動増幅を測ります。q=0の重複特異値では個々の特異ベクトルは一意ではありません。",
    "en": "Use Hadamard orthogonal factors U,V and sⱼ=2⁻qj for q=0/4/8/12. Fixed b=u₀ and b+2⁻⁴⁰u_min measure perturbation amplification. Individual singular vectors are nonunique for the repeated singular values at q=0."
  },
  "algorithm": {
    "ja": "Householder QR、片側Jacobi SVD、三角後退代入を実装します。SVDの数値階数閾値を10⁻⁸/10⁻¹²/10⁻¹⁴へ変え、同じ切捨て規約のLAPACK解と比較します。正規方程式の計算例は追加していません。",
    "en": "Implement Householder QR, one-sided Jacobi SVD and triangular back substitution. Vary rank cutoffs 10⁻⁸/10⁻¹²/10⁻¹⁴ and compare with LAPACK solutions using the same truncation convention. No executed normal-equations comparison is added."
  },
  "validation": {
    "ja": "再構成・直交性・特異値・右辺摂動による解差・最小二乗停留残差・厳密階数2の対照を保存します。高精度参照は実二進入力を整数比へ変換し、mpmath 1.3.0のSVDとQRを独立実行済みです。SHAと全4入力・両精度の完全性を実行時に検査し、不一致を解析解へ置換しません。",
    "en": "Save reconstruction, orthogonality, singular values, solution perturbations, least-squares stationarity and an exact rank-two control. The mpmath1.3.0 SVD and QR reference was actually executed using integer-ratio conversions of binary inputs. Runtime SHA and completeness guards check all four inputs at both precisions and never substitute analytic truth after a mismatch."
  },
  "limits": {
    "ja": "LAPACKと教材の射影コアには共通の数値基盤が含まれます。mpmath SVDは別実装の二重対角化とQR反復、mpmath最小二乗は同じHouseholder群の別高精度実装です。どの高条件数行列にも微小特異値の相対高精度を保証するものではありません。",
    "en": "Some LAPACK and projected-core numerical infrastructure is shared. mpmath SVD uses separate bidiagonalization and QR iteration; mpmath least squares is a separate high-precision implementation of the same Householder family. Tiny-singular-value relative accuracy is not guaranteed for arbitrary ill-conditioned matrices."
  },
  "references": [
    {
      "id": "householder1958",
      "author": "A. S. Householder",
      "year": 1958,
      "title": "Unitary Triangularization of a Nonsymmetric Matrix",
      "doi": "10.1145/320941.320947",
      "url": "https://dl.acm.org/doi/10.1145/320941.320947",
      "review_level": "publisher-metadata",
      "journal": "Journal of the ACM 5(4), 339–342",
      "type": "article"
    },
    {
      "id": "demmel-veselic1992",
      "author": "J. Demmel, K. Veselić",
      "year": 1992,
      "title": "Jacobi’s Method is More Accurate than QR",
      "doi": "10.1137/0613074",
      "url": "https://epubs.siam.org/doi/abs/10.1137/0613074",
      "review_level": "primary publisher abstract and bibliographic metadata",
      "journal": "SIAM Journal on Matrix Analysis and Applications 13(4), 1204–1245",
      "type": "article",
      "review": {
        "ja": "適切な停止規準と行列の成分ごとの条件に依存する相対精度の主張を確認しました。一般の高条件数行列における微小特異値の万能な相対精度とはしません。",
        "en": "Checked the dependence of relative-accuracy statements on stopping rules and componentwise sensitivity; not a blanket accuracy guarantee for tiny singular values of arbitrary ill-conditioned matrices."
      }
    },
    {
      "id": "lapack-ls-error",
      "author": "LAPACK authors",
      "year": 1999,
      "title": "Further Details: Error Bounds for Linear Least Squares Problems",
      "url": "https://netlib.org/lapack/lug/node83.html",
      "review_level": "official implementation documentation, error-analysis and numerical-rank sections",
      "review": {
        "ja": "小さな後退誤差と前進誤差を区別し、最小二乗では条件数だけでなく残差の角度にも依存すること、RCONDによる切捨ては数値階数の規約であることを確認しました。",
        "en": "Checked backward versus forward error, the residual-angle dependence of least-squares sensitivity, and numerical-rank truncation controlled by RCOND."
      }
    },
    {
      "id": "mpmath130-reference",
      "author": "mpmath developers",
      "year": 2023,
      "title": "mpmath 1.3.0 matrix documentation and installed implementation",
      "url": "https://mpmath.org/doc/1.3.0/matrices.html",
      "supporting_url": "https://pypi.org/pypi/mpmath/1.3.0/json",
      "review_level": "official matrix documentation and selected installed mpmath1.3.0 source (svd_r_raw, qr_solve), plus actual 80/120dps fixed-input execution",
      "review": {
        "ja": "SVDはHouseholder二重対角化とQR反復、最小二乗は別実装の高精度Householder QRです。後者は教材のQRと同じ数理的手法群であり、別の手法群とは呼びません。実際の二進浮動小数点入力を整数比で読み込み、生成専用環境で実行しました。",
        "en": "SVD uses Householder bidiagonalization and a QR variant; least squares uses a separate high-precision Householder QR implementation. The latter shares the educational QR mathematical family and is not called a different algorithm family. Actual binary floating-point inputs were loaded by integer ratios and executed in a generation-only environment."
      }
    }
  ],
  "reference_implementations": [
    "https://docs.scipy.org/doc/scipy/reference/generated/scipy.linalg.svd.html",
