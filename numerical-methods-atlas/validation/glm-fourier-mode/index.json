{
  "id": "glm-fourier-mode",
  "title": {
    "ja": "GLMの磁気単極子モード：解析的減衰",
    "en": "GLM longitudinal mode: analytic damping"
  },
  "method_ids": [
    "glm"
  ],
  "summary": {
    "ja": "GLM cleaning単独の縦磁場Fourierモードを、連続線形方程式の行列指数解と比較します。",
    "en": "Compare a longitudinal magnetic Fourier mode of GLM cleaning with the continuous linear matrix-exponential solution."
  },
  "assumptions": {
    "ja": "周期[0,1]、Bx=cos2πx、psi=0、ch=1、減衰κ=2、t=1。流体との結合を外した線形診断です。",
    "en": "Periodic [0,1], Bx=cos2pix, psi=0, ch=1, damping kappa=2, t=1. This linear diagnostic omits fluid coupling."
  },
  "algorithm": {
    "ja": "∂tBx=-∂xpsi、∂tpsi=-ch²∂xBx-κpsiを中心差分とRK4で積分。独立参照は連続Fourier記号の2×2行列指数です。",
    "en": "Integrate Bx_t=-psi_x and psi_t=-ch² Bx_x-kappa psi with centered differences/RK4. The independent reference exponentiates the continuous 2x2 Fourier symbol."
  },
  "validation": {
    "ja": "16/32/64点でL2誤差、空間2次収束、磁場divergenceモード振幅の減衰を判定します。",
    "en": "Check L2 error, second-order spatial refinement and damping of the divergence-mode amplitude at 16/32/64 points."
  },
  "limits": {
    "ja": "この線形モードの減衰を、非線形MHDの全divergenceや大域的な精度の保証とはしません。CTで表せない単極子モードをCTとの同条件比較には用いません。",
    "en": "Linear-mode damping does not guarantee divergence control or global accuracy for every nonlinear MHD problem. A monopole mode that CT cannot represent is not used as a matched CT comparison."
  },
  "references": [
    {
      "id": "dedner2002",
      "author": "A. Dedner et al.",
      "year": 2002,
      "title": "Hyperbolic Divergence Cleaning for the MHD Equations",
      "doi": "10.1006/jcph.2001.6961",
      "url": "https://www.tp4.ruhr-uni-bochum.de/~sw/papers/JCP2002.6961.pdf",
      "review_level": "author-hosted primary paper; linear cleaning equations checked"
    }
  ],
  "equations": [
    "B_t=-\\psi_x,\\quad\\psi_t=-c_h^2B_x-\\kappa\\psi"
  ],
  "code_files": [
    "run.py"
  ],
