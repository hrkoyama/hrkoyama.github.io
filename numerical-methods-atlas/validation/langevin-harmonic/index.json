      "doi": null,
      "url": "https://docs.scipy.org/doc/scipy-1.14.1/reference/generated/scipy.linalg.solve_discrete_lyapunov.html",
      "review_level": "official-api-documentation",
      "review": {
        "ja": "公式の離散Lyapunov方程式AXA^H-X+Q=0の符号と返却仕様を確認。",
        "en": "Official equation AXA^H-X+Q=0, signs and output specification checked."
      },
      "type": "documentation"
    },
    {
      "id": "scipy-1.14.1-expm",
