{
  "id": "gaussian-mcmc",
  "title": {
    "ja": "Gaussian標的のMCMC：分布・自己相関・ESS",
    "en": "Gaussian-target MCMC: distribution, autocorrelation and ESS"
  },
  "method_ids": [
    "mcmc"
  ],
  "domains": [
    "probability"
  ],
  "summary": {
    "ja": "32本のMetropolis連鎖を既知の標準正規分布へ照合し、平均・分散・CDF、自己相関時間、ESSと標本予算依存を記録します。",
    "en": "Check 32 Metropolis chains against a known standard-normal target; record mean, variance, CDF, autocorrelation time, ESS and sample-budget dependence."
  },
  "assumptions": {
    "ja": "無次元1変数、対称Gaussianランダムウォーク提案幅1.5。固定master seedから32の別PCG64ストリームを生成し、1024回のburn-in後に各8192標本を保持します。",
    "en": "One dimensionless variable and symmetric Gaussian random-walk width1.5. Spawn 32 separate PCG64 streams from a fixed master seed; retain 8192 samples per chain after 1024 burn-in steps."
  },
  "algorithm": {
    "ja": "log受理比でMetropolis更新。FFTによる連鎖内自己共分散を平均し、Geyerのgamma0+gamma1から始まる初期正ペア和から平均観測量のESSを求めます。古典的split-Rhatも併記します。",
    "en": "Use a log-acceptance Metropolis update. Pool FFT within-chain autocovariances and obtain mean-observable ESS from Geyer initial-positive pairs starting at gamma0+gamma1. Also report classical split-Rhat."
  },
  "validation": {
    "ja": "正規CDFを独立参照とし、標本数1024/2048/8192の連鎖平均RMSEを比較。別の定常AR(1)系列と厳密tau=(1+rho)/(1-rho)で診断量を照合します。公差は固定入力で事前指定します。",
    "en": "Use the normal CDF as an independent analytic reference and compare chain-mean RMSE at 1024/2048/8192 retained samples. A separate stationary AR(1) sequence and exact tau=(1+rho)/(1-rho) check the diagnostic. Acceptance is predeclared in fixed inputs."
  },
  "limits": {
    "ja": "固定seed・予算での統計検査です。ESSは平均という観測量だけ、Rhatはrank正規化版ではありません。多峰性・高次元・任意のseedでの混合や所定の偽陽性率は保証しません。",
    "en": "Statistical checks apply to fixed seeds and budgets. ESS concerns the mean only; Rhat is not rank-normalized. No guarantee covers multimodality, high dimensions, every seed, mixing or a specified false-positive rate."
  },
  "formulas": [
    "\\pi(x)=(2\\pi)^{-1/2}e^{-x^2/2},\\quad \\alpha=\\min(1,e^{-(y^2-x^2)/2})",
    "\\tau=-1+2\\sum_{k=0}^{K}(\\rho_{2k}+\\rho_{2k+1}),\\qquad N_{\\rm eff}=MN/\\max(1,\\tau)"
  ],
