{
  "id": "radiation-transport",
  "title": {
    "ja": "純吸収平板の離散座標放射輸送",
    "en": "Discrete-ordinate radiation transport through an absorbing slab"
  },
  "method_ids": [
    "radiation-transport"
  ],
  "summary": {
    "ja": "純吸収の定常放射輸送を角度と空間で離散化し、Beer–Lambert解と積分された出射フラックスで検証します。",
    "en": "Discretize steady pure-absorption transfer in angle and space, checking Beer–Lambert rays and integrated exit flux."
  },
  "assumptions": {
    "ja": "光学的厚さ0.7の一様平板。正の半球から単位強度が入射し、逆向きの入射・散乱・内部放射はゼロです。",
    "en": "A uniform slab of optical depth 0.7 receives unit intensity over the positive hemisphere, with zero reverse inflow, scattering and emission."
  },
  "algorithm": {
    "ja": "正のGauss–Legendre離散方向と1次風上有限体積の空間行進を使います。角度誤差だけを分ける系列では、一定セル内を指数関数で正確に伝播します。",
    "en": "Use positive Gauss–Legendre ordinates and first-order upstream finite-volume marching. A separate angular-error sweep uses exact exponential propagation within each constant cell."
  },
  "validation": {
    "ja": "32〜512セルで全方向の強度誤差・空間フラックス誤差・正値性・離散吸収収支を確認。4〜32方向の別系列は、出射フラックス2pi E3(tau)の解析表示と比較します。",
    "en": "With 32–512 cells, check all ray intensities, spatial flux error, positivity and discrete absorption balance. A separate 4–32-ordinate sweep compares exit flux with the analytic 2pi E3(tau) representation."
  },
  "limits": {
    "ja": "多重散乱、熱放射、周波数再分配、動的媒質、放射流体連成は未実装です。StamnesらのDISORTの全機能・安定化を再現したとは表示しません。",
    "en": "Multiple scattering, thermal emission, frequency redistribution, moving media and radiation–fluid coupling are unimplemented. This does not reproduce full DISORT functionality/stabilization."
  },
  "equations": [
    "\\mu\\frac{dI}{d\\tau}+I=0,\\qquad I(\\tau,\\mu)=e^{-\\tau/\\mu}",
    "F_{\\rm out}=2\\pi\\int_0^1\\mu e^{-\\tau/\\mu}d\\mu=2\\pi E_3(\\tau)"
  ],
  "references": [
    {
      "id": "stamnes1988",
      "author": "K. Stamnes, S.-C. Tsay, W. Wiscombe and K. Jayaweera",
      "year": 1988,
      "title": "Numerically stable algorithm for discrete-ordinate-method radiative transfer in multiple scattering and emitting layered media",
      "doi": "10.1364/AO.27.002502",
      "url": "https://doi.org/10.1364/AO.27.002502",
      "review_level": "selected-full-text",
      "review_note": {
        "ja": "出版社HTMLの書誌・抄録と基本の輸送式を確認。離散座標の背景として引用し、本例はDISORT全機能の実装ではありません。",
        "en": "Publisher HTML bibliography, abstract and base transfer equation checked; cited as discrete-ordinate background, not full DISORT implementation."
      }
    },
    {
      "id": "dlmf-expint",
      "author": "NIST Digital Library of Mathematical Functions",
      "year": 2026,
      "title": "§8.19 Generalized Exponential Integral",
      "doi": null,
      "url": "https://dlmf.nist.gov/8.19",
      "review_level": "official-documentation",
      "review_note": {
        "ja": "一般化指数積分の積分表示を公式資料で確認。年は確認年。",
        "en": "Official integral representation of the generalized exponential integral checked; year denotes access year."
      }
    }
  ],
