{
  "id": "ewald",
  "title": {
    "ja": "中性周期セルのEwald和と独立theta積分",
    "en": "Neutral-cell Ewald sums and an independent theta integral"
  },
  "method_ids": [
    "ewald"
  ],
  "summary": {
    "ja": "3次元周期Coulomb相互作用の実空間和・逆空間和・自己項を実装し、分割パラメータと打切りを変えて検証します。",
    "en": "Implement real-space, reciprocal-space and self Ewald terms for neutral 3D periodic Coulomb charges; vary splitting and cutoffs."
  },
  "assumptions": {
    "ja": "立方セル・全電荷ゼロ・Coulomb定数1・導体境界（tin foil）。主例は非対称な8点電荷で、NaClの8イオン配置は別の解析照合用です。",
    "en": "Cubic cell, zero total charge, Coulomb constant one and conducting/tin-foil boundary. An asymmetric eight-charge case is distinct from the eight-ion NaCl reference cell."
  },
  "algorithm": {
    "ja": "erfcで減衰する実空間和、Gaussian係数を持つ構造因子の逆格子和、−alpha/sqrt(pi) sum(q²)を加えます。力は各項の位置微分から求め、24成分を中心エネルギー差分と比較します。",
    "en": "Combine an erfc-screened image sum, Gaussian-damped reciprocal structure factors and the self correction. Differentiate each term and check all 24 force components against central energy differences."
  },
  "validation": {
    "ja": "分割alphaを3点、実空間打切りを3点、逆空間打切りを4点で確認。NaClのMadelung定数は3次元和を呼ばない独立な1次元Jacobi-theta積分と照合し、求積の誤差推定も保存します。",
    "en": "Three splitting parameters, three real cutoffs and four reciprocal cutoffs. Check the NaCl Madelung constant against a separately implemented 1D Jacobi-theta integral, storing its quadrature error estimate."
  },
  "limits": {
    "ja": "非中性セル、背景補正、非直交セル、誘電率が有限の表面項、スラブ補正、応力、物質固有の力場は扱いません。",
    "en": "No charged-cell/background correction, triclinic cell, finite-dielectric surface term, slab correction, stress or material-specific force field."
  },
  "equations": [
    "E=\\frac12\\sum_{ij\\mathbf n}^{\\prime}q_iq_j\\frac{\\operatorname{erfc}(\\alpha r_{ij\\mathbf n})}{r_{ij\\mathbf n}}+\\frac{2\\pi}{V}\\sum_{\\mathbf k\\ne0}\\frac{e^{-k^2/(4\\alpha^2)}}{k^2}|S(\\mathbf k)|^2-\\frac{\\alpha}{\\sqrt\\pi}\\sum_iq_i^2",
    "M_{\\rm NaCl}=\\frac2{\\sqrt\\pi}\\int_0^\\infty[1-\\vartheta_4(0,e^{-u^2})^3]du"
  ],
