  "equations": [
    {
      "id": "bgk",
      "name": {
        "ja": "等温格子BGK",
        "en": "Isothermal lattice BGK"
      },
      "formula": [
        "f_q(\\boldsymbol x+\\boldsymbol c_q,t+1)=f_q(\\boldsymbol x,t)-\\frac{f_q-f_q^{\\rm eq}}{\\tau}+S_q"
      ],
      "note": {
        "ja": "格子単位Δx=Δt=1の衝突・並進更新。D2Q9等温・低Mach数のせん断波とPoiseuille流を扱います。",
        "en": "Collision/streaming in lattice units Δx=Δt=1. Examples cover D2Q9 isothermal low-Mach shear waves and Poiseuille flow."
      },
      "url": {
        "ja": "https://hrkoyama.github.io/numerical-methods-atlas/equations/?lang=ja#bgk-ja",
        "en": "https://hrkoyama.github.io/numerical-methods-atlas/equations/?lang=en#bgk-en"
      }
    },
    {
      "id": "navier-stokes",
      "name": {
        "ja": "非圧縮Navier–Stokes",
        "en": "Incompressible Navier–Stokes"
      },
      "formula": [
        "\\partial_t\\boldsymbol u+(\\boldsymbol u\\cdot\\nabla)\\boldsymbol u=-\\rho^{-1}\\nabla p+\\nu\\nabla^2\\boldsymbol u",
        "\\nabla\\cdot\\boldsymbol u=0"
      ],
      "note": {
        "ja": "一定密度・粘性の代表形。公開例は周期2次元MAC格子の射影法とTaylor–Green渦です。",
        "en": "A representative constant-density, constant-viscosity form. Public examples use periodic 2D MAC projection and a Taylor–Green vortex."
      },
      "url": {
        "ja": "https://hrkoyama.github.io/numerical-methods-atlas/equations/?lang=ja#navier-stokes-ja",
        "en": "https://hrkoyama.github.io/numerical-methods-atlas/equations/?lang=en#navier-stokes-en"
      }
    }
  ],
  "equation_note": {
    "ja": "格子BGKが計算モデル、非圧縮Navier–Stokesは低Mach数で比較する巨視的な減衰モデルです。",
    "en": "Lattice BGK is the computed model; incompressible Navier–Stokes supplies the low-Mach macroscopic decay comparison."
  },
  "formulations": [],
  "references": [
    {
      "id": "sine-heat",
      "kind": "analytic",
      "kind_label": {
        "ja": "解析解",
        "en": "Analytic reference"
      },
      "title": {
        "ja": "熱拡散／Fourierモードの減衰",
        "en": "Heat / Fourier-mode decay"
      },
      "formula": "u = 1 + 0.25 sin(2πx) exp[−0.02(2π)²t]",
      "assumptions": {
        "ja": "単位区間の周期境界、拡散係数0.02。",
        "en": "Periodic unit interval; viscosity 0.02."
      },
      "relation": "related-model",
      "note": {
        "ja": "周期せん断速度の線形粘性減衰とスカラー熱モードは同型ですが、LBMの格子単位・波数・粘性と参照カードのν=0.02は異なります。",
        "en": "Linear viscous shear decay and scalar heat modes have the same form, but LBM lattice units, wavenumber and viscosity differ from the card’s ν=0.02."
      },
      "url": {
        "ja": "https://hrkoyama.github.io/numerical-methods-atlas/?lang=ja#/exact-solutions?case=sine-heat",
        "en": "https://hrkoyama.github.io/numerical-methods-atlas/?lang=en#/exact-solutions?case=sine-heat"
      }
    }
  ],
  "reference_note": {
    "ja": "低Mach数の周期せん断波について、粘性Fourier減衰から測定した粘性と収束を確認します。熱方程式の参照カードは同型の減衰の関連例です。",
    "en": "For a low-Mach periodic shear wave, infer viscosity from Fourier decay and check refinement. The heat reference card is a related scalar decay model."
  },
