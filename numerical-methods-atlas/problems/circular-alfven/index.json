  "equations": [
    {
      "id": "mhd",
      "name": {
        "ja": "理想MHD",
        "en": "Ideal magnetohydrodynamics"
      },
      "formula": [
        "\\rho_t+\\nabla\\cdot(\\rho\\boldsymbol v)=0",
        "(\\rho\\boldsymbol v)_t+\\nabla\\cdot[\\rho\\boldsymbol v\\otimes\\boldsymbol v+(p+B^2/2)I-\\boldsymbol B\\otimes\\boldsymbol B]=0",
        "E_t+\\nabla\\cdot[(E+p+B^2/2)\\boldsymbol v-(\\boldsymbol v\\cdot\\boldsymbol B)\\boldsymbol B]=0",
        "\\boldsymbol B_t=\\nabla\\times(\\boldsymbol v\\times\\boldsymbol B),\\quad\\nabla\\cdot\\boldsymbol B=0"
      ],
      "note": {
        "ja": "透磁率を1とする理想MHDの代表形。Eは熱・運動・磁場を含む全エネルギー密度。解説でCT・GLMと発散の測り方、HLLDテストへ進めます。",
        "en": "Representative ideal MHD with magnetic permeability set to one. E is total thermal, kinetic and magnetic energy density. Follow CT/GLM, divergence conventions and HLLD tests."
      },
      "url": {
        "ja": "https://hrkoyama.github.io/numerical-methods-atlas/equations/?lang=ja#mhd-ja",
        "en": "https://hrkoyama.github.io/numerical-methods-atlas/equations/?lang=en#mhd-en"
      }
    }
  ],
