      "id": "hyperbolic-diffusion",
      "name": {
        "ja": "補助的な双曲型拡散系",
        "en": "Auxiliary hyperbolic diffusion system"
      },
      "formula": [
        "\\partial_\\tau u-\\nu\\partial_xp=f",
        "\\partial_\\tau p-T_r^{-1}\\partial_xu=-p/T_r"
      ],
      "note": {
        "ja": "τは擬似時間、Trは緩和時間。定常でp=uₓ、−νuₓₓ=fを回復します。物理時間の熱拡散とは区別します。",
        "en": "τ is pseudo-time and Tr a relaxation time. At steady state p=uₓ and −νuₓₓ=f are recovered; this is distinct from physical-time heat diffusion."
      },
      "url": {
        "ja": "https://hrkoyama.github.io/numerical-methods-atlas/equations/?lang=ja#hyperbolic-diffusion-ja",
